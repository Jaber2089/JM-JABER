<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JM JABER | Fashion & Electronics</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,"Noto Sans Bengali",sans-serif;
}

body{
  background:#f6f7fb;
  color:#222;
}

/* Header */
header{
  background:linear-gradient(135deg,#111827,#4c1d95);
  color:white;
  padding:18px 15px;
  position:sticky;
  top:0;
  z-index:1000;
  box-shadow:0 3px 15px rgba(0,0,0,.2);
}

.nav{
  max-width:1100px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-size:25px;
  font-weight:900;
  letter-spacing:1px;
}

.cart{
  background:#fff;
  color:#4c1d95;
  padding:9px 13px;
  border-radius:25px;
  font-weight:bold;
}

/* Hero */
.hero{
  background:linear-gradient(135deg,#4c1d95,#7c3aed,#db2777);
  color:white;
  padding:55px 20px;
  text-align:center;
}

.hero h1{
  font-size:38px;
  margin-bottom:12px;
}

.hero p{
  font-size:17px;
  margin-bottom:25px;
}

.hero-btn{
  display:inline-block;
  background:white;
  color:#4c1d95;
  padding:13px 25px;
  border-radius:30px;
  text-decoration:none;
  font-weight:bold;
}

/* Categories */
.section{
  max-width:1100px;
  margin:auto;
  padding:35px 15px;
}

.section-title{
  text-align:center;
  font-size:27px;
  margin-bottom:25px;
}

.categories{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:15px;
}

.category{
  padding:25px 15px;
  border-radius:18px;
  color:white;
  text-align:center;
  font-size:19px;
  font-weight:bold;
  box-shadow:0 5px 15px rgba(0,0,0,.12);
}

.fashion{
  background:linear-gradient(135deg,#ec4899,#be185d);
}

.electronics{
  background:linear-gradient(135deg,#2563eb,#1e40af);
}

/* Products */
.products{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:18px;
}

.product{
  background:white;
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 5px 18px rgba(0,0,0,.09);
  transition:.3s;
}

.product:hover{
  transform:translateY(-5px);
}

.product-img{
  width:100%;
  height:170px;
  background:#eee;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:50px;
}

.product-info{
  padding:15px;
}

.product h3{
  font-size:17px;
  margin-bottom:8px;
}

.price{
  color:#7c3aed;
  font-size:19px;
  font-weight:bold;
  margin-bottom:12px;
}

.order{
  display:block;
  text-align:center;
  background:#16a34a;
  color:white;
  padding:10px;
  border-radius:10px;
  text-decoration:none;
  font-weight:bold;
}

/* Search */
.search{
  width:100%;
  padding:14px 18px;
  border:1px solid #ddd;
  border-radius:30px;
  outline:none;
  font-size:16px;
  margin-bottom:25px;
}

/* About */
.about{
  background:white;
  border-radius:20px;
  padding:25px;
  line-height:1.8;
  box-shadow:0 5px 18px rgba(0,0,0,.07);
}

/* Footer */
footer{
  background:#111827;
  color:white;
  text-align:center;
  padding:30px 15px;
  margin-top:30px;
}

footer h2{
  margin-bottom:10px;
}

footer p{
  margin:7px 0;
}

.whatsapp{
  display:inline-block;
  background:#16a34a;
  color:white;
  padding:12px 22px;
  border-radius:25px;
  text-decoration:none;
  font-weight:bold;
  margin-top:12px;
}

/* Mobile */
@media(max-width:600px){
  .hero h1{
    font-size:31px;
  }

  .products{
    grid-template-columns:repeat(2,1fr);
  }

  .product-img{
    height:135px;
  }
}

@media(min-width:800px){
  .products{
    grid-template-columns:repeat(4,1fr);
  }
}
</style>
</head>

